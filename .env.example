# ═══════════════════════════════════════════════════════════════════
# QUROXA INDEPENDENT PATIENT FRONTEND — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env.local (for local development) or configure in Render dashboard.
# Never commit real credentials or production secrets to source control.

# Backend API Base URL
# IMPORTANT:
# - In local development with Vite proxy: leave empty or use http://localhost:5000/api
# - In production / Render: set to your deployed backend URL WITH the /api suffix:
#   Example: https://quroxa-backend.onrender.com/api
# - The client automatically appends /api if you omit it, but providing the full
#   path with /api is the recommended standard convention.
VITE_API_URL=http://localhost:5000/api

# Dedicated Socket.IO Real-Time Gateway URL
# IMPORTANT:
# - Socket.IO connects to the server root (WITHOUT /api suffix):
#   Example: http://localhost:5000 or https://quroxa-backend.onrender.com
# - If omitted, the client automatically strips /api from VITE_API_URL.
VITE_SOCKET_URL=http://localhost:5000
